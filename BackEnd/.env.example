# ═══════════════════════════════════════════════════════════════════════════════
#  MediCare AI — Backend Environment Variables
#  Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=mongodb://localhost:27017/MediCare

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=4000

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key for doctor JWT tokens
SecretKey=your_doctor_secret_key_here

# Secret key for patient JWT tokens
P_SecretKey=your_patient_secret_key_here

# JWT token expiration time
ExpireIn=6h

# ── VideoSDK Configuration ────────────────────────────────────────────────────
# Get your credentials from https://app.videosdk.live/
VIDEOSDK_API_KEY=your_videosdk_api_key_here
VIDEOSDK_SECRET_KEY=your_videosdk_secret_key_here

# ── VideoSDK Webhook Configuration ────────────────────────────────────────────
# Must be publicly reachable for VideoSDK webhooks to work
# 
# LOCAL DEVELOPMENT:
#   1. Run: ngrok http 4000
#   2. Copy the ngrok URL (e.g., https://abc123.ngrok-free.app)
#   3. Set: WEBHOOK_BASE_URL=https://abc123.ngrok-free.app
#
# PRODUCTION:
#   Set to your actual domain (e.g., https://api.medicare-ai.com)
#
WEBHOOK_BASE_URL=http://localhost:4000
