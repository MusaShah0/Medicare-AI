# ─────────────────────────────────────────────────────────────────────────────
#  MediCare AI — Environment Variables
#  Copy this file to .env and fill in your values before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=your_doctor_jwt_secret_here
P_JWT_SECRET=your_patient_jwt_secret_here

VIDEOSDK_API_KEY=your_videosdk_api_key
VIDEOSDK_SECRET=your_videosdk_secret

# ── AI Service ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# ── Frontend (build-time) ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
